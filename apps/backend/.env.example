# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Yjs sync runtime
#--------------------------------------------------------------------
YJS_DOC_FLUSH_MS=8
YJS_MAX_BUFFERED_BYTES=1048576
YJS_MAX_WARM_ROOMS=100
YJS_STORE_DEBOUNCE_MS=2000
YJS_LEVELDB_PATH=./tmp/writeboard-yjs-db
YJS_WEBSOCKET_PATH=/sync
